# Copier en .env.local et remplir. .env* est déjà exclu du dépôt (voir .gitignore).

# URL publique de l'app — sert à construire la redirection OAuth Google.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fonnte (livraison des codes OTP sur WhatsApp) — conservé le temps que l'API
# WhatsApp Business officielle soit approuvée par Meta (voir ROADMAP.md, Phase 6)
FONNTE_TOKEN=

# Secret du "Send SMS Hook" Supabase, affiché à la création du hook dans
# Authentication -> Hooks. Format : v1,whsec_xxxxx
# Sans lui, /api/auth/hooks/send-sms refuse tous les appels.
SUPABASE_SEND_SMS_HOOK_SECRET=

# Sel du hachage des visiteurs de boutique (Phase 3). Aucune adresse IP n'est
# conservée : seule une empreinte SHA-256 de (IP + user agent + sel) sert à
# distinguer deux visiteurs. Mettre une valeur aléatoire en production.
VISIT_HASH_SALT=

# Numéro Mobile Money de Watshop, vers lequel les vendeurs transfèrent pour
# passer en Pro (Phase 4). Tant qu'il est vide, l'écran d'abonnement le dit au
# lieu d'afficher un numéro faux.
WATSHOP_MOBILE_MONEY_NUMBER=

# --- Phases suivantes, pas encore utilisées ---
# Cloudflare R2 (Phase 2, stockage images produits/logos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# GNAKRYPAY (Phase 4, différé)
GNAKRYPAY_API_KEY=
