# Copier en .env.local et remplir. .env* est déjà exclu du dépôt (voir .gitignore).

# URL publique de l'app — sert à construire la redirection OAuth Google.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vidéo-guide de la page d'accueil (« comment créer sa boutique »). Lien YouTube,
# Vimeo, ou fichier .mp4/.webm hébergé. Tant que vide, la section reste masquée.
NEXT_PUBLIC_GUIDE_VIDEO_URL=

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fonnte (livraison des codes OTP sur WhatsApp) — conservé le temps que l'API
# WhatsApp Business officielle soit approuvée par Meta (voir ROADMAP.md, Phase 6)
FONNTE_TOKEN=

# Secret du "Send SMS Hook" Supabase, affiché à la création du hook dans
# Authentication -> Hooks. Format : v1,whsec_xxxxx
# Sans lui, /api/auth/hooks/send-sms refuse tous les appels.
SUPABASE_SEND_SMS_HOOK_SECRET=

# Sel du hachage des visiteurs de boutique (Phase 3). Aucune adresse IP n'est
# conservée : seule une empreinte SHA-256 de (IP + user agent + sel) sert à
# distinguer deux visiteurs. Mettre une valeur aléatoire en production.
VISIT_HASH_SALT=

# Numéro Mobile Money de Watshop, vers lequel les vendeurs transfèrent pour
# passer en Pro (Phase 4). Tant qu'il est vide, l'écran d'abonnement le dit au
# lieu d'afficher un numéro faux.
WATSHOP_MOBILE_MONEY_NUMBER=

# --- Phases suivantes, pas encore utilisées ---
# Cloudflare R2 (Phase 2, stockage images produits/logos)
# Notifications push (Phase 5) — paire de cles VAPID, generee une fois par
# projet avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:watshopafrica@gmail.com

# Clé d'API 21st.dev, pour installer leurs composants avec le CLI shadcn.
# Uniquement utile en développement : rien à reporter dans Vercel.
TWENTY_FIRST_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# GNAKRYPAY — passerelle de paiement.
# L encaissement passe par un prestataire ; seul src/lib/payment/gnakrypay/
# le sait, tout le reste du code ne connait que GNAKRYPAY.
# Identifiants : espace developpeur du prestataire, environnement production.
GNAKRYPAY_API_URL=https://prod-api.djomy.africa
GNAKRYPAY_CLIENT_ID=
GNAKRYPAY_CLIENT_SECRET=
# Facultatif : les webhooks sont signes avec le Client Secret ci-dessus.
# A ne renseigner que si le prestataire fournit un jour une cle distincte.
GNAKRYPAY_WEBHOOK_SECRET=

# Sortie par IP fixe pour les appels de la passerelle, quand son pare-feu
# (Cloudflare) bloque les IP d'hébergement. Adresse d'un proxy à IP fixe :
# http://[utilisateur:motdepasse@]hote:port. C'est CETTE IP qu'on donne au
# prestataire pour sa liste blanche. Vide = tout part en direct.
GNAKRYPAY_PROXY_URL=

# Secret partagé avec le planificateur Vercel, qui appelle chaque matin
# /api/cron/abonnements : rappels de réabonnement puis fermeture des
# abonnements dont le délai de grâce est écoulé. Sans ce secret, la route
# refuse tout appel — un défaut ouvert laisserait n'importe qui déclencher
# les envois en boucle et faire bannir notre compte WhatsApp.
CRON_SECRET=
